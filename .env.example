
# "claude" (best reliability, paid), or "gemini" (free but hits rate limits easily)
MODEL_PROVIDER=openai

OPENAI_API_KEY= "enter_your_api"
OPENAI_MODEL=gpt-4.1-mini 


# Groq API key (free, no card needed) -- https://console.groq.com/keys
GROQ_API_KEY= "enter_your_api"

# Anthropic (Claude) API key -- https://console.anthropic.com/ (optional)
ANTHROPIC_API_KEY= "enter_your_api"
ANTHROPIC_MODEL=claude-sonnet-5
# Gemini API key -- https://aistudio.google.com/apikey (optional)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# --- Email notifications (sent to staff when a booking hold is created) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER= "enter your own email"
SMTP_PASSWORD= "enter your own password"
HOTEL_STAFF_EMAIL= "your staff email"

# --- Telegram (only needed if running telegram_bot.py) ---
TELEGRAM_BOT_TOKEN= "create your own bot token"
